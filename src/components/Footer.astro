---
import { Image } from 'astro:assets';
import github from '../images/github.svg';
import linkedin from '../images/linkedin.svg';

const links = [
  { url: 'https://github.com/1612492', alt: 'github', image: github },
  {
    url: 'https://www.linkedin.com/in/phat-vo98',
    alt: 'linkedin',
    image: linkedin,
  },
];
---

<div class="mx-auto max-w-screen-lg px-3 py-6">
  <div class="border-t border-main pt-5 sm:flex sm:items-center sm:justify-between">
    <div class="text-sm text-heading">© Copyright {new Date().getFullYear()} by Phat Vo.</div>
    <div class="mt-4 flex items-center gap-x-3 sm:mt-0">
      <a class="text-sm hover:text-heading" href="mailto:votanphatb2@gmail.com">
        Email
      </a>
      {links.map(({ url, alt, image }) => (
        <a href={url} aria-label={alt} target="_blank" rel="noreferrer">
          <Image src={image} alt={alt} class="h-8 w-8" />
        </a>
      ))}
    </div>
  </div>
</div>
