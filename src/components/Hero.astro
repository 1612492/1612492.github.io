---
import { Image } from 'astro:assets';
import avatar from '../images/avatar.svg';

const skills = [
  { name: 'React', color: 'bg-blue' },
  { name: 'Next.js', color: 'bg-indigo' },
  { name: 'TanStack Start', color: 'bg-sky' },
  { name: 'React Native', color: 'bg-cyan' },
  { name: 'TypeScript', color: 'bg-blue' },
  { name: 'Node.js', color: 'bg-green' },
  { name: 'Hono', color: 'bg-orange' },
  { name: 'Express', color: 'bg-teal' },
  { name: 'PostgreSQL', color: 'bg-emerald' },
  { name: 'REST', color: 'bg-lime' },
  { name: 'GraphQL', color: 'bg-pink' },
  { name: 'Blockchain indexers', color: 'bg-violet' },
  { name: 'Web3', color: 'bg-purple' },
  { name: 'Vitest', color: 'bg-amber' },
  { name: 'AI-assisted development', color: 'bg-fuchsia' },
];
---

<section class="mx-auto max-w-screen-lg px-3 py-6">
  <div class="flex flex-col items-center md:flex-row md:justify-between md:gap-x-24">
    <div>
      <h1 class="text-3xl font-semibold text-heading">
        Hi there, I'm <span class="text-primary">Phat</span> 👋
      </h1>

      <p class="mt-6 leading-9">
        I'm a full-stack developer building web and mobile products with React, TypeScript, and
        Node.js. I turn complex APIs, data pipelines, and blockchain integrations into reliable
        experiences, using AI tools to work efficiently and verify the results.
      </p>

      <h2 class="mt-6 font-semibold text-heading">Skills & tools</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {skills.map(({ name, color }) => (
          <li class:list={['rounded-md px-3 py-1 text-sm font-medium text-heading', color]}>
            {name}
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-wrap gap-4 font-medium">
        <a class="text-primary hover:text-heading" href="mailto:votanphatb2@gmail.com">
          Get in touch →
        </a>
        <a class="text-primary hover:text-heading" href="https://github.com/1612492">
          GitHub →
        </a>
      </div>
    </div>

    <div class="shrink-0">
      <Image src={avatar} alt="Illustration of Phat Vo" class="h-80 w-64" />
    </div>
  </div>
</section>
